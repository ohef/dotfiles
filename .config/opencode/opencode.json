{
  "$schema": "https://opencode.ai/config.json",
  "tool_output": {
    "max_bytes": 10000000, 
    "max_lines": 20000
  },
  "plugin": [
    "opencode-models-discovery@latest"
  ],
  "attachment": {
    "image": {
      "auto_resize": false,
      "max_width": 1000000,
      "max_height": 1000000,
      "max_base64_bytes": 10000000
    }
  },
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "https://llama.ai.ohefn.org/v1",
        "modelsDiscovery" : {
          "enabled" : true,
          "modelInfoFormat": "llama-swap"
        }
      }
    }
  }
}
